# Pilot-request form — Web3Forms access key (public endpoint id, NOT a secret).
# Create one free at https://web3forms.com, point it at your destination inbox,
# and enable domain restriction + a captcha to stop abuse of the public key.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Absolute site URL, used for canonical/hreflang/sitemap/OG.
# e.g. https://qafila-robotics.github.io/Landing-page  or  https://your-domain.qa
NEXT_PUBLIC_SITE_URL=https://qafila-robotics.github.io/Landing-page

# Base path for a GitHub Pages PROJECT repo (served under /<repo>).
# Leave empty for an org-pages repo (qafila-robotics.github.io) or a custom domain.
# In CI this is set automatically by the deploy workflow.
BASE_PATH=
